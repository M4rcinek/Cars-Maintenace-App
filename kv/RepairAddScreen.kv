<RepairAddScreen>:
    canvas.before:
        Color:
            rgba: 0.035, 0.045, 0.04, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(15)
        spacing: dp(10)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                color: 0.9, 1, 0.92, 1
                id: repair_type_text
                text: app.get_translation("repair_type")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: repair_type
                text: ""
                multiline: False
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                hint_text_color: 0.4, 0.5, 0.43, 1
                cursor_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                id: description_text
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("description")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: description
                text: ""
                multiline: False
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                hint_text_color: 0.4, 0.5, 0.43, 1
                cursor_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                id: cost_text
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("cost")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: cost
                text: ""
                multiline: False
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                hint_text_color: 0.4, 0.5, 0.43, 1
                cursor_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                id: mileage_text
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("mileage")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: mileage
                text: ""
                multiline: False
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                hint_text_color: 0.4, 0.5, 0.43, 1
                cursor_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                id: repair_date_text
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("repair_date")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: repair_date
                text: ""
                multiline: False
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                hint_text_color: 0.4, 0.5, 0.43, 1
                cursor_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                id: part_number_text
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("part_number")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: part_number
                text: ""
                multiline: False
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                hint_text_color: 0.4, 0.5, 0.43, 1
                cursor_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(10)

            Label:
                color: 0.9, 1, 0.92, 1
                id: reg_number_text
                text: app.get_translation("reg_number")
                size_hint_x: 0.3
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: reg_number
                disabled: 1
                background_normal: ""
                background_active: ""
                background_color: 0.01, 0.01, 0.01, 1
                disabled_background_color: 0.01, 0.01, 0.01, 1
                foreground_color: app.accent_color
                disabled_foreground_color: app.accent_color
                padding: dp(12), dp(8)

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(8)

        BoxLayout:
            size_hint_y: 0.15
            spacing: dp(10)

            Button:
                id: button_save
                text: app.get_translation("save")
                background_normal: ""
                background_color: app.accent_color
                color: 0.02, 0.05, 0.03, 1
                font_size: "18sp"
                bold: True
                on_press: root.SaveAndAdd()

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)

            Button:
                text: app.get_translation("cancel")
                id: button_cancel
                background_normal: ""
                background_color: 0.01, 0.01, 0.01, 1
                color: 0.9, 1, 0.92, 1
                font_size: "18sp"
                bold: True
                on_press: root.GetBack()

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)