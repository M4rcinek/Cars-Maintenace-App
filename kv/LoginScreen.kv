<LoginScreen>:
    canvas.before:
        Color:
            rgba: 0.035, 0.045, 0.04, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: 40
        spacing: 20

        Label:
            color: app.accent_color
            id: logging
            text: app.get_translation("logging")
            font_size: 32

        TextInput:
            id: username
            hint_text: app.get_translation("username")
            multiline: False
            foreground_color: 0.9, 1, 0.92, 1
            hint_text_color: 0.45, 0.55, 0.48, 1
            background_normal: ""
            background_active: ""
            background_color: 0.055, 0.07, 0.06, 1
            cursor_color: app.accent_color
            padding: 15, 10

            canvas.after:
                Color:
                    rgba: app.accent_color
                Line:
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(10)
                    width: 1.2

        TextInput:
            id: password
            hint_text: app.get_translation("password")
            password: True
            multiline: False
            foreground_color: 0.9, 1, 0.92, 1
            hint_text_color: 0.45, 0.55, 0.48, 1
            background_normal: ""
            background_active: ""
            background_color: 0.055, 0.07, 0.06, 1
            cursor_color: app.accent_color
            padding: 15, 10

            canvas.after:
                Color:
                    rgba: app.accent_color
                Line:
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(10)
                    width: 1.2

        Button:
            text: app.get_translation("log_in")
            id: login
            background_color: app.accent_color
            color: 0.02, 0.05, 0.03, 1
            on_release: root.AuthenticateUser()

        Button:
            text: app.get_translation("close")
            id: close
            background_color: 0.055, 0.07, 0.06, 1
            color: 0.9, 1, 0.92, 1
            on_release: app.get_running_app().stop()

            canvas.before:
                Color:
                    rgba: app.accent_color
                Line:
                    width: 1.2
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(10)

        BoxLayout:
            size_hint: 1, .15

            Button:
                canvas.before:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)

                text: "EN"
                background_color: 0.055, 0.07, 0.06, 1
                color: app.accent_color
                on_release: root.ChangeToEN()

                Image:
                    source: 'media/uk.png'
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y

            Button:
                canvas.before:
                    Color:
                        rgba: app.accent_color
                    Line:
                        width: 1.2
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)

                text: "PL"
                background_color: 0.055, 0.07, 0.06, 1
                color: app.accent_color
                on_release: root.ChangeToPL()

                Image:
                    source: 'media/poland.png'
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y