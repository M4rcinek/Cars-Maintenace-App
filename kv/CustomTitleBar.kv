<CustomTitleBar>:
    canvas.before:
        Color:
            rgba: 0.055, 0.07, 0.06, 1
        Rectangle:
            pos: self.pos
            size: self.size

        Color:
            rgba: app.accent_color
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(1)

    BoxLayout:
        size_hint_x: 0.9
        padding: dp(12), 0

        Label:
            id: logged
            text_size: self.size
            halign: "left"
            valign: "middle"

            color: app.accent_color
            font_size: "13sp"
            bold: True

    BoxLayout:
        size_hint_x: 0.1

        Button:
            color: 0.75, 0.85, 0.78, 1
            text: "-"
            font_size: "17sp"
            background_normal: ""
            background_color: 0.055, 0.07, 0.06, 1
            on_release: root.minimize()

        Button:
            color: 0.75, 0.85, 0.78, 1
            text: "[]"
            font_size: "13sp"
            background_normal: ""
            background_color: 0.055, 0.07, 0.06, 1
            on_release: root.maximize()

        Button:
            text: "X"
            font_size: "15sp"
            bold: True
            color: 1, 0.3, 0.3, 1
            background_normal: ""
            background_color: 0.055, 0.07, 0.06, 1
            on_release: app.stop()