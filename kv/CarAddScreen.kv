<CarAddScreen>:
    canvas.before:
        Color:
            rgba: 0.035, 0.045, 0.04, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(30)
        spacing: dp(15)

        # =========================
        # FORMULARZ
        # =========================

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("reg_number")
                id: reg_number_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: reg_number
                text: ""
                size_hint_x: 0.65
                multiline: False
                padding: dp(12), dp(10)
                foreground_color: 0.9, 1, 0.92, 1
                hint_text_color: 0.45, 0.55, 0.48, 1
                background_normal: ""
                background_active: ""
                background_color: 0.055, 0.07, 0.06, 1
                cursor_color: app.accent_color

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("make")
                id: make_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: make
                text: ""
                size_hint_x: 0.65
                multiline: False
                padding: dp(12), dp(10)
                foreground_color: 0.9, 1, 0.92, 1
                hint_text_color: 0.45, 0.55, 0.48, 1
                background_normal: ""
                background_active: ""
                background_color: 0.055, 0.07, 0.06, 1
                cursor_color: app.accent_color

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("model")
                id: model_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: model
                text: ""
                size_hint_x: 0.65
                multiline: False
                padding: dp(12), dp(10)
                foreground_color: 0.9, 1, 0.92, 1
                hint_text_color: 0.45, 0.55, 0.48, 1
                background_normal: ""
                background_active: ""
                background_color: 0.055, 0.07, 0.06, 1
                cursor_color: app.accent_color

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("vin")
                id: vin_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: vin
                text: ""
                size_hint_x: 0.65
                multiline: False
                padding: dp(12), dp(10)
                foreground_color: 0.9, 1, 0.92, 1
                hint_text_color: 0.45, 0.55, 0.48, 1
                background_normal: ""
                background_active: ""
                background_color: 0.055, 0.07, 0.06, 1
                cursor_color: app.accent_color

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("displacement")
                id: displacement_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: displacement
                text: ""
                hint_text: "cm3"
                size_hint_x: 0.65
                multiline: False
                padding: dp(12), dp(10)
                foreground_color: 0.9, 1, 0.92, 1
                hint_text_color: 0.45, 0.55, 0.48, 1
                background_normal: ""
                background_active: ""
                background_color: 0.055, 0.07, 0.06, 1
                cursor_color: app.accent_color

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("date_of_purchase")
                id: date_of_purchase_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            TextInput:
                id: date_of_purchase
                text: ""
                hint_text: "RRRR-MM-DD"
                size_hint_x: 0.65
                multiline: False
                padding: dp(12), dp(10)
                foreground_color: 0.9, 1, 0.92, 1
                hint_text_color: 0.45, 0.55, 0.48, 1
                background_normal: ""
                background_active: ""
                background_color: 0.055, 0.07, 0.06, 1
                cursor_color: app.accent_color

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("fuel_type")
                id: fuel_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            Spinner:
                id: fuel
                size_hint_x: 0.65
                background_normal: ""
                background_color: 0.055, 0.07, 0.06, 1
                color: app.accent_color
                values: ["Elektryczny", "Benzyna", "Diesel", "CNG", "Benzyna+LPG"]

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        BoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            Label:
                color: 0.9, 1, 0.92, 1
                text: app.get_translation("photo")
                id: photo_text
                size_hint_x: 0.35
                halign: "left"
                valign: "middle"
                text_size: self.size

            Button:
                id: filechooser
                text: app.get_translation("add_photo")
                size_hint_x: 0.65
                background_normal: ""
                background_color: 0.055, 0.07, 0.06, 1
                color: app.accent_color
                bold: True
                on_release: root.AddPhoto()

                canvas.before:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

        # =========================
        # PRZYCISKI
        # =========================

        BoxLayout:
            spacing: dp(15)
            size_hint_y: None
            height: dp(55)

            Button:
                id: save_button
                text: app.get_translation("save")
                background_normal: ""
                background_color: app.accent_color
                color: 0.02, 0.05, 0.03, 1
                bold: True
                font_size: "16sp"
                on_press: root.SaveAndAdd()

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2

            Button:
                id: back_button
                text: app.get_translation("cancel")
                background_normal: ""
                background_color: 0.055, 0.07, 0.06, 1
                color: 0.9, 1, 0.92, 1
                bold: True
                font_size: "16sp"
                on_press: root.CancelAndGoBack()

                canvas.after:
                    Color:
                        rgba: app.accent_color
                    Line:
                        rounded_rectangle:
                            self.x, self.y, self.width, self.height, dp(10)
                        width: 1.2